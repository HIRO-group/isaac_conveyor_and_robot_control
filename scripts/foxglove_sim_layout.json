{
  "configById": {
    "Image!sim1pick": {
      "imageMode": { "imageTopic": "theia/camera/SIM1-PICK/color" },
      "foxglovePanelTitle": "SIM1-PICK"
    },
    "Image!sim2pick": {
      "imageMode": { "imageTopic": "theia/camera/SIM2-PICK/color" },
      "foxglovePanelTitle": "SIM2-PICK"
    },
    "Image!sim1place": {
      "imageMode": { "imageTopic": "theia/camera/SIM1-PLACE/color" },
      "foxglovePanelTitle": "SIM1-PLACE"
    },
    "Image!sim2place": {
      "imageMode": { "imageTopic": "theia/camera/SIM2-PLACE/color" },
      "foxglovePanelTitle": "SIM2-PLACE"
    },
    "Image!sim1hand": {
      "imageMode": { "imageTopic": "theia/camera/SIM1-HAND/color" },
      "foxglovePanelTitle": "SIM1-HAND"
    },
    "Image!sim2hand": {
      "imageMode": { "imageTopic": "theia/camera/SIM2-HAND/color" },
      "foxglovePanelTitle": "SIM2-HAND"
    },
    "Plot!conveyors": {
      "foxglovePanelTitle": "Conveyor speeds",
      "paths": [
        { "value": "theia/plc/state_conveyors.Conveyors[:].Speed", "enabled": true, "timestampMethod": "receiveTime" }
      ]
    },
    "Plot!joints": {
      "foxglovePanelTitle": "Arm joints (deg)",
      "paths": [
        { "value": "theia/robot/arm1/position_status.joint_degrees[:]", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "theia/robot/arm2/position_status.joint_degrees[:]", "enabled": true, "timestampMethod": "receiveTime" }
      ]
    },
    "StateTransitions!phases": {
      "foxglovePanelTitle": "Arm phases",
      "paths": [
        { "value": "sim/arms/phase{arm==1}.to_phase", "timestampMethod": "receiveTime" },
        { "value": "sim/arms/phase{arm==2}.to_phase", "timestampMethod": "receiveTime" }
      ]
    },
    "RawMessages!runmeta": {
      "foxglovePanelTitle": "Run metadata",
      "topicPath": "sim/run_metadata"
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": { "speed": 1 },
  "layout": {
    "direction": "column",
    "splitPercentage": 65,
    "first": {
      "direction": "row",
      "splitPercentage": 33.3,
      "first": {
        "direction": "column",
        "first": "Image!sim1pick",
        "second": "Image!sim2pick"
      },
      "second": {
        "direction": "row",
        "splitPercentage": 50,
        "first": {
          "direction": "column",
          "first": "Image!sim1place",
          "second": "Image!sim2place"
        },
        "second": {
          "direction": "column",
          "first": "Image!sim1hand",
          "second": "Image!sim2hand"
        }
      }
    },
    "second": {
      "direction": "row",
      "splitPercentage": 30,
      "first": "Plot!conveyors",
      "second": {
        "direction": "row",
        "splitPercentage": 45,
        "first": "Plot!joints",
        "second": {
          "direction": "row",
          "splitPercentage": 60,
          "first": "StateTransitions!phases",
          "second": "RawMessages!runmeta"
        }
      }
    }
  }
}
